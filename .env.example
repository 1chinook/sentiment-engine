# Application Configuration
APP_NAME=sentiment-engine
APP_VERSION=1.0.0
WORK_MODE=TEST_SIMULATION
LOG_LEVEL=INFO

# Optional Security (Leave empty in development; set in production to require X-API-Key header)
API_KEY=

# Database (Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/sentiment_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# NLP Model Configuration
NLP_MODEL_NAME=cardiffnlp/twitter-xlm-roberta-base-sentiment
NLP_USE_FALLBACK_IF_UNAVAILABLE=true
NLP_MAX_BATCH_SIZE=64
NLP_DEVICE=cpu

# Ingestion & Orchestrator Configuration
INGESTION_BATCH_SIZE=20
BACKOFF_BASE_DELAY_SEC=1.0
BACKOFF_MAX_RETRIES=3
MOCK_FAILURE_RATE=0.0

# Dead Letter Queue (DLQ) Paths
DLQ_FILE_PATH=logs/failed_batches.jsonl
CORRUPTED_DLQ_FILE_PATH=logs/corrupted_dlq.jsonl

# APScheduler Background Worker Intervals (seconds)
SCHEDULER_INGEST_INTERVAL_SEC=10
SCHEDULER_DLQ_INTERVAL_SEC=60

# Spike / Hype Detector & Webhook Notifications (Live Stream Clip Automation)
ALERT_SENTIMENT_THRESHOLD=0.45
ALERT_MIN_BATCH_SIZE=5
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SEC=5.0

# Real Ingestion Sources (Used when WORK_MODE=PRODUCTION)
TWITCH_CHANNEL=
MARKET_RSS_URLS=https://feeds.bbci.co.uk/news/business/rss.xml
MOVIE_RSS_URLS=https://letterboxd.com/journal/rss/
